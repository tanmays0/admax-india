# Frontend API base — use /api so Vite proxies to the Express backend in development
VITE_API_URL=/api

# Absolute API origin for OAuth redirects (optional; defaults to Vite /api proxy)
# VITE_API_ORIGIN=http://localhost:5000

# Stripe publishable key (optional — backend /api/stripe/config also exposes it)
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional Razorpay public key (leave blank to use backend mock checkout)
VITE_RAZORPAY_KEY=
