PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=admax_india

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Public URL used for local media links (no trailing slash)
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub (https://github.com/settings/developers)
# Authorization callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudinary (optional — leave blank to store uploads locally in /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (optional — leave blank for mock payment orders in development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe (subscriptions, checkout, portal, webhooks)
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Price IDs from Stripe Dashboard → Products
# If blank, checkout uses inline price_data (INR)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
